{
  "name": "sociacl-ids",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Canonical SociACL identities, path keys and credential proofs for browsers and Node",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.js",
    "typecheck": "tsc --strict --noEmit",
    "browser": "node scripts/browser.mjs",
    "consumer": "node scripts/consumer.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1"
  },
  "peerDependencies": {
    "zod": "^4.1.12"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "fast-check": "4.3.0",
    "esbuild": "0.25.11",
    "zod": "4.1.12"
  }
}
