{
  "notes": [
    "typescript/src may use WebCrypto. The audit flags import, export from, require, dynamic import(), createRequire, and process.getBuiltinModule of the specifiers crypto and node:crypto, including multi-line forms and template literals. Strings and comments are ignored.",
    "Template text is ignored; executable substitutions are scanned, including nested templates. Scanning resumes after the closing backtick."
  ],
  "allowed": [
    {"name": "webcrypto-global", "source": "const bytes = globalThis.crypto.getRandomValues(new Uint8Array(16));"},
    {"name": "webcrypto-subtle", "source": "await crypto.subtle.digest('SHA-256', bytes);"},
    {"name": "line-comment", "source": "// import \"node:crypto\"\nconst x = 1;"},
    {"name": "block-comment", "source": "/* require('crypto') */\nconst x = 1;"},
    {"name": "string-holds-import", "source": "const s = 'import \"node:crypto\";';"},
    {"name": "string-holds-comment-markers", "source": "const a = \"/* // */\";\nconst x = globalThis.crypto;"},
    {"name": "interpolated-template", "source": "const s = `${value}`;"},
    {"name": "template-text-holds-import", "source": "const s = `${value} import \"node:crypto\"; require(\"crypto\")`;"},
    {"name": "nested-template-text", "source": "const s = `outer ${`inner ${value}`} require(\"crypto\")`;"},
    {"name": "escaped-interpolation-text", "source": "const s = `\\${require(\"crypto\")}`;"},
    {"name": "interpolation-string-and-comment", "source": "const s = `${({ value: \"}\" /* } */ }).value}`;"},
    {"name": "unicode-expression", "source": "const s = `${π}`; const π2 = 2;"}
  ],
  "banned": [
    {"name": "import-crypto", "source": "import { randomBytes } from \"crypto\";"},
    {"name": "import-node-crypto", "source": "import { webcrypto } from 'node:crypto';"},
    {"name": "import-side-effect", "source": "import \"crypto\";"},
    {"name": "require-crypto", "source": "const c = require(\"crypto\");"},
    {"name": "require-node-crypto", "source": "const c = require('node:crypto');"},
    {"name": "dynamic-crypto", "source": "const c = await import(\"crypto\");"},
    {"name": "dynamic-node-crypto", "source": "const c = import('node:crypto');"},
    {"name": "multiline-import", "source": "import {\n  randomBytes\n} from \"node:crypto\";"},
    {"name": "export-from", "source": "export { randomBytes } from \"node:crypto\";"},
    {"name": "export-star", "source": "export * from \"node:crypto\";"},
    {"name": "template-import", "source": "const c = import(`node:crypto`);"},
    {"name": "after-string-slash-slash", "source": "const s = \"http://example.com\"; import \"node:crypto\";"},
    {"name": "after-string-block-markers", "source": "const a = \"/*\";\nimport \"node:crypto\";\nconst b = \"*/\";"},
    {"name": "create-require", "source": "createRequire(import.meta.url)(\"node:crypto\");"},
    {"name": "get-builtin-module", "source": "process.getBuiltinModule(\"node:crypto\");"},
    {"name": "import-after-interpolated-template", "source": "const s = `${value}`; import \"node:crypto\";"},
    {"name": "require-after-interpolated-template", "source": "const s = `${value}`; require(\"crypto\");"},
    {"name": "export-after-interpolated-template", "source": "const s = `${value}`; export * from \"crypto\";"},
    {"name": "dynamic-import-after-interpolated-template", "source": "const s = `${value}`; import(`node:crypto`);"},
    {"name": "create-require-after-interpolated-template", "source": "const s = `${value}`; createRequire(import.meta.url)(\"crypto\");"},
    {"name": "builtin-after-interpolated-template", "source": "const s = `${value}`; process.getBuiltinModule(\"crypto\");"},
    {"name": "import-after-nested-template", "source": "const s = `outer ${`inner ${value}`}`; import \"node:crypto\";"},
    {"name": "require-after-balanced-interpolation", "source": "const s = `${({ value: \"}\" /* } */ }).value}`; require(\"crypto\");"},
    {"name": "import-inside-interpolation", "source": "const s = `${await import(\"node:crypto\")}`;"},
    {"name": "require-inside-nested-interpolation", "source": "const s = `${`inner ${require(\"crypto\")}`}`;"},
    {"name": "import-after-unicode-interpolation", "source": "const s = `${π}`; import \"node:crypto\";"},
    {"name": "import-after-escaped-backtick", "source": "const s = `escaped \\` ${value}`; import \"crypto\";"}
  ]
}
