{
  "notes": [
    "typescript/src may use WebCrypto. The audit flags import, export from, require, dynamic import(), createRequire, and process.getBuiltinModule of the specifiers crypto and node:crypto, including multi-line forms and template literals. The pinned TypeScript parser distinguishes strings, comments, regex literals, and division. Invalid syntax fails the audit.",
    "Template text is ignored; executable substitutions are scanned, including nested templates. Scanning resumes after the closing backtick."
  ],
  "invalid": [
    {"name": "unclosed-regex", "source": "const re = /unterminated"},
    {"name": "unclosed-string", "source": "const s = \"unterminated"},
    {"name": "unclosed-comment", "source": "/* unterminated"}
  ],
  "allowed": [
    {"name": "regex-holds-import", "source": "const re = /import \"node:crypto\"/;"},
    {"name": "regex-holds-require", "source": "const re = /require('crypto')/;"},
    {"name": "regex-quotes-and-backticks", "source": "const re = /['\"`]/g;"},
    {"name": "ordinary-division", "source": "const x = 20 / 4 / 5;"},
    {"name": "regex-inside-template", "source": "const s = `${/}/.test(value)}`;"},
    {"name": "comment-after-regex", "source": "const re = /\"/; // import \"crypto\";"},
    {"name": "deeply-nested-template", "source": "const s = `outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${`outer ${value}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`}`;"},
    {"name": "webcrypto-global", "source": "const bytes = globalThis.crypto.getRandomValues(new Uint8Array(16));"},
